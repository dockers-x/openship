# Docker image source. Use ghcr.io/dockers-x to pull the GHCR copies.
OPENSHIP_IMAGE_PREFIX=czyt
OPENSHIP_VERSION=0.4.5

NODE_ENV=production

# false = self-hosted; true = SaaS.
CLOUD_MODE=false
DEPLOY_MODE=docker
CLOUD_MAX_PROJECTS_PER_USER=2
# OPENSHIP_TARGET=local

# PostgreSQL used by the Compose stack.
POSTGRES_USER=openship
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=openship

# Compose overrides DATABASE_URL and REDIS_URL with internal service addresses.
DATABASE_URL=postgresql://openship:openship@localhost:5432/openship
REDIS_URL=redis://localhost:6379
OPENSHIP_REQUIRE_REDIS=true

# Generate each secret independently, for example:
#   openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret
BETTER_AUTH_URL=http://localhost:4000
INTERNAL_TOKEN=replace-with-a-different-random-32-byte-secret

# Optional OAuth login.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# SaaS-only settings.
GITHUB_APP_SLUG=openship-io
# GITHUB_APP_ID=
# GITHUB_PRIVATE_KEY_BASE64=
# GITHUB_WEBHOOK_SECRET=
# OBLIEN_CLIENT_ID=
# OBLIEN_CLIENT_SECRET=
# OBLIEN_WEBHOOK_SECRET=

# Optional transactional email.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Openship <noreply@example.com>

SYSTEM_DEBUG_LOGS=false
